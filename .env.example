# ============================================================
# 语音识别（STT）—— 二选一，也可在网页右上角「接口设置」里填写
# ============================================================

# ── 方式 A：本地 Whisper（推荐，无需 Key）──
# 启动 local-stt/ 服务后，在网页里选「本地 Whisper」即可，
# 地址默认 http://localhost:8000/v1，模型默认 large-v3。
# 下面两个变量仅用于把本地设为服务端默认：

# TRANSCRIBE_BASE_URL=http://localhost:8000/v1
# TRANSCRIBE_MODEL=large-v3

# ── 方式 B：在线接口（需 Key）──
# 任意兼容 OpenAI /audio/transcriptions 的接口地址
TRANSCRIBE_BASE_URL=https://api.together.xyz/v1
# 供应商 API Key（推荐在网页里填写，仅存于浏览器本地）
TRANSCRIBE_API_KEY=
# 模型名称（需支持词级时间戳，例如 openai/whisper-large-v3）
TRANSCRIBE_MODEL=openai/whisper-large-v3

# 兼容旧配置：未填 TRANSCRIBE_API_KEY 时会回退读取此项
TOGETHER_API_KEY=

# ============================================================
# 字幕翻译（可选，在线，兼容 OpenAI /chat/completions）
# ============================================================
TRANSLATE_BASE_URL=https://api.siliconflow.cn/v1
TRANSLATE_API_KEY=
TRANSLATE_MODEL=Qwen/Qwen2.5-7B-Instruct

# ============================================================
# AI 配音（可选，在线，兼容 OpenAI /audio/speech）
# 用于「AI 配音 MP4」：把翻译后的字幕合成为目标语言语音并混入视频。
# 也可在网页右上角「接口设置 → 配音」里填写。
# ============================================================
DUB_BASE_URL=https://api.siliconflow.cn/v1
DUB_API_KEY=
DUB_MODEL=FunAudioLLM/CosyVoice2-0.5B
DUB_VOICE=alex

# ── FFmpeg ──
# 自建服务器推荐安装系统 ffmpeg 并在此指定路径；
# 留空时会依次尝试 npm 自带的 @ffmpeg-installer 二进制、系统 PATH 中的 ffmpeg。
FFMPEG_PATH=

# ── 站点地址（用于生成 OG 图片/sitemap 的绝对链接，可留空）──
NEXT_PUBLIC_SITE_URL=

# 可选：Vercel Blob（自建服务器通常不需要）
BLOB_READ_WRITE_TOKEN=
