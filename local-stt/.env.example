# 本地 Whisper STT 服务配置示例
# 复制为 .env 后按需修改；本服务会读取同名环境变量。
# 注意：本服务不依赖任何 API Key。

# 默认模型：tiny / base / small / medium / large-v3
# CPU 上 large-v3 较慢，建议先用 small 或 medium 试用。
STT_MODEL=large-v3

# 计算设备与精度
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# 束搜索宽度
STT_BEAM_SIZE=5

# 模型下载目录
STT_MODELS_DIR=./models

# 是否启用 VAD（语音活动检测）过滤静音
STT_VAD=true

# 监听地址与端口
STT_HOST=0.0.0.0
STT_PORT=8000

# 国内下载模型慢时，取消注释使用 HuggingFace 镜像
# HF_ENDPOINT=https://hf-mirror.com
